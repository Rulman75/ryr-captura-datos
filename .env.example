# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS NEON (PostgreSQL Serverless)
# ============================================================================
# Copia tu cadena de conexión desde el dashboard de Neon (https://console.neon.tech)
DATABASE_URL="postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================================================
# CONFIGURACIÓN DE CORREO (NODEMAILER - GMAIL O SMTP CORPORATIVO)
# ============================================================================
# Para Gmail: usa tu correo y una "Contraseña de Aplicación" de 16 caracteres
# generada en https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM_NAME="Inventario RYR Importadora"
